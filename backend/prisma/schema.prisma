generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    DEAN
    TEACHER
    TPO
    STUDENT
    ADMIN
}

enum StaffRole {
    DEAN
    TEACHER
    TPO
}

enum BadgeStatus {
    PENDING
    APPROVED
    REJECTED
}

enum PostType {
    DEAN_NOTICE
    PROJECT_SHOWCASE
    PLACEMENT_UPDATE
    HACKATHON_WIN
    GENERAL
}

model User {
    id           String   @id @default(uuid())
    email        String   @unique
    passwordHash String
    role         UserRole
    isActive     Boolean  @default(true)

    student      Student?
    staff        StaffRegistry?
    staffProfile StaffProfile?

    // Feed relations
    posts        Post[]
    postLikes    PostLike[]
    postComments PostComment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StaffProfile {
    id String @id @default(uuid())

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    fullName     String
    profileImage String?
    designation  String
    department   String
    about        String

    areasOfExpertise String[] @default([])
    subjects         String[] @default([])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Student {
    id              String  @id @default(uuid())
    name            String
    email           String  @unique
    collegeName     String
    rollNumber      String  @unique
    libraryId       String? @unique
    course          String
    branch          String
    batch           Int
    currentSemester Int?    @default(1)

    // Authentication relation
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    studentProfile  StudentProfile?
    academicRecords AcademicRecord[]
    projects        Project[]
    certifications  Certification[]
    badges          StudentBadge[]
}

model StaffRegistry {
    id      String    @id @default(uuid())
    name    String?
    staffId String?   @unique
    email   String    @unique
    role    StaffRole

    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentProfile {
    id        String @id @default(uuid())
    studentId String @unique

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    username  String  @unique
    bio       String?
    avatarUrl String?

    githubUrl     String?
    linkedinUrl   String?
    leetcodeUrl   String?
    codeforcesUrl String?
    codechefUrl   String?
    xUrl          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AcademicRecord {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    semester Int
    sgpa     Float
    cgpa     Float
    backlogs Int   @default(0)

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, semester])
}

model Project {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title       String
    tagline     String?
    description String
    githubUrl   String?
    demoUrl     String?
    techStack   String[]

    isPinned   Boolean   @default(false)
    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Certification {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title          String
    issuer         String
    credentialId   String?
    credentialUrl  String?
    certificateUrl String?

    issuedAt  DateTime?
    expiresAt DateTime?

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BadgeCatalog {
    id          String  @id @default(uuid())
    title       String  @unique
    description String
    imageUrl    String?
    category    String?

    badges StudentBadge[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentBadge {
    id        String  @id @default(uuid())
    studentId String
    student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    badgeId      String?
    badgeCatalog BadgeCatalog? @relation(fields: [badgeId], references: [id], onDelete: SetNull)

    title       String
    description String?
    imageUrl    String?

    proofUrl      String?
    screenshotUrl String?

    status     BadgeStatus @default(PENDING)
    reviewedBy String?
    reviewedAt DateTime?

    awardedBy String?
    awardedAt DateTime?

    isPinned Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// FEED MODULE
// -------------------------------------------------------------

model Post {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    type     PostType @default(GENERAL)
    content  String
    hashtags String[] @default([])
    imageUrl String?
    imageTag String?

    // Optional Project Showcase metadata
    projectRepo  String?
    projectUrl   String?
    projectStack String[] @default([])
    projectStars Int?     @default(0)

    isPinned Boolean @default(false)

    likes    PostLike[]
    comments PostComment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model PostLike {
    id     String @id @default(uuid())
    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([postId, userId])
}

model PostComment {
    id     String @id @default(uuid())
    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model CampusSignal {
    id        String   @id @default(uuid())
    title     String
    category  String? // e.g. "CRPC", "ACADEMIC", "ENDORSEMENT"
    timeText  String? // e.g. "15m ago"
    linkUrl   String?
    createdAt DateTime @default(now())
}

model AlumniDirectory {
    id            String   @id @default(uuid())
    fullName      String   @db.VarChar(120)
    avatarUrl     String?
    company       String   @db.VarChar(120) // e.g. "Microsoft", "Amazon"
    role          String   @db.VarChar(120) // e.g. "Software Development Engineer II"
    batch         String // e.g. "Class of 2024"
    passoutYear   Int // e.g. 2024 (Numeric filter)
    branch        String // e.g. "CSE", "IT", "ECE"
    domain        String   @db.VarChar(80) // "Distributed Systems", "Cloud & DevOps", "AI / ML"
    skills        String[] @default([]) // ["Next.js", "Azure", "C++"]
    linkedinUrl   String // Mandatory LinkedIn profile URL
    verifiedByTpo Boolean  @default(true)
    workEmail     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([company])
    @@index([domain])
    @@index([passoutYear])
    @@index([branch])
}
