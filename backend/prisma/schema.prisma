generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    DEAN
    TEACHER
    TPO
    STUDENT
    ADMIN
}

enum StaffRole {
    DEAN
    TEACHER
    TPO
}

model User {
    id                 String   @id @default(uuid())
    email              String   @unique
    passwordHash       String
    role               UserRole
    isActive           Boolean  @default(true)
    mustChangePassword Boolean  @default(false)

    student      Student?
    staff        StaffRegistry?
    staffProfile StaffProfile?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StaffProfile {
    id String @id @default(uuid())

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    fullName     String
    profileImage String?
    designation  String
    department   String
    about        String

    areasOfExpertise String[] @default([])
    subjects         String[] @default([])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Student {
    id          String  @id @default(uuid())
    name        String
    email       String  @unique
    collegeName String
    rollNumber  String  @unique
    libraryId   String? @unique
    course      String
    branch      String
    batch       Int

    // Authentication relation
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    studentProfile  StudentProfile?
    academicRecords AcademicRecord[]
    projects        Project[]
    certifications  Certification[]
    badges          StudentBadge[]
}

model StaffRegistry {
    id      String    @id @default(uuid())
    name    String?
    staffId String?   @unique
    email   String    @unique
    role    StaffRole

    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentProfile {
    id        String @id @default(uuid())
    studentId String @unique

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    username  String  @unique
    bio       String?
    avatarUrl String?

    githubUrl     String?
    linkedinUrl   String?
    leetcodeUrl   String?
    codeforcesUrl String?
    codechefUrl   String?
    xUrl          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AcademicRecord {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    semester Int
    sgpa     Float
    cgpa     Float
    backlogs Int   @default(0)

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, semester])
}

model Project {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title       String
    tagline     String?
    description String
    githubUrl   String?
    demoUrl     String?
    techStack   String[]

    isPinned   Boolean   @default(false)
    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Certification {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title          String
    issuer         String
    credentialId   String?
    credentialUrl  String?
    certificateUrl String?

    issuedAt  DateTime?
    expiresAt DateTime?

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentBadge {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title       String
    description String?
    imageUrl    String?

    awardedBy String?
    awardedAt DateTime @default(now())

    createdAt DateTime @default(now())
}
