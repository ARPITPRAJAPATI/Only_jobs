generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// ============================================================================
// 1. AUTH & USER IDENTITY
// ============================================================================

enum UserRole {
    DEAN
    TEACHER
    TPO
    STUDENT
    ADMIN
}

enum StaffRole {
    DEAN
    TEACHER
    TPO
}

model User {
    id           String   @id @default(uuid())
    email        String   @unique
    passwordHash String
    role         UserRole
    isActive     Boolean  @default(true)

    student      Student?
    staff        StaffRegistry?
    staffProfile StaffProfile?

    // Feed relations
    posts        Post[]
    postLikes    PostLike[]
    postComments PostComment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StaffRegistry {
    id      String    @id @default(uuid())
    name    String?
    staffId String?   @unique
    email   String    @unique
    role    StaffRole

    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StaffProfile {
    id String @id @default(uuid())

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    fullName     String
    profileImage String?
    designation  String
    department   String
    about        String

    areasOfExpertise String[] @default([])
    subjects         String[] @default([])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ============================================================================
// 2. STUDENT PORTFOLIO & ACADEMICS
// ============================================================================

model Student {
    id              String  @id @default(uuid())
    name            String
    email           String  @unique
    collegeName     String
    rollNumber      String  @unique
    libraryId       String? @unique
    course          String
    branch          String
    batch           Int
    currentSemester Int?    @default(1)

    // Authentication relation
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    studentProfile  StudentProfile?
    academicRecords AcademicRecord[]
    projects        Project[]
    certifications  Certification[]
    badges          StudentBadge[]
    jobApplications JobApplication[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentProfile {
    id        String @id @default(uuid())
    studentId String @unique

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    username  String  @unique
    bio       String?
    avatarUrl String?

    githubUrl     String?
    linkedinUrl   String?
    leetcodeUrl   String?
    codeforcesUrl String?
    codechefUrl   String?
    xUrl          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AcademicRecord {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    semester Int
    sgpa     Float
    cgpa     Float
    backlogs Int   @default(0)

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, semester])
}

model Project {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title       String
    tagline     String?
    description String
    githubUrl   String?
    demoUrl     String?
    techStack   String[]

    isPinned   Boolean   @default(false)
    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Certification {
    id        String @id @default(uuid())
    studentId String

    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    title          String
    issuer         String
    credentialId   String?
    credentialUrl  String?
    certificateUrl String?

    issuedAt  DateTime?
    expiresAt DateTime?

    isVerified Boolean   @default(false)
    verifiedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ============================================================================
// 3. BADGES & RECOGNITION
// ============================================================================

enum BadgeStatus {
    PENDING
    APPROVED
    REJECTED
}

model BadgeCatalog {
    id          String  @id @default(uuid())
    title       String  @unique
    description String
    imageUrl    String?
    category    String?

    badges StudentBadge[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudentBadge {
    id        String  @id @default(uuid())
    studentId String
    student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    badgeId      String?
    badgeCatalog BadgeCatalog? @relation(fields: [badgeId], references: [id], onDelete: SetNull)

    title       String
    description String?
    imageUrl    String?

    proofUrl      String?
    screenshotUrl String?

    status     BadgeStatus @default(PENDING)
    reviewedBy String?
    reviewedAt DateTime?

    awardedBy String?
    awardedAt DateTime?

    isPinned Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ============================================================================
// 4. CAMPUS FEED & SIGNALS
// ============================================================================

enum PostType {
    DEAN_NOTICE
    PROJECT_SHOWCASE
    PLACEMENT_UPDATE
    HACKATHON_WIN
    GENERAL
}

model Post {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    type     PostType @default(GENERAL)
    content  String
    hashtags String[] @default([])
    imageUrl String?
    imageTag String?

    // Optional Project Showcase metadata
    projectRepo  String?
    projectUrl   String?
    projectStack String[] @default([])
    projectStars Int?     @default(0)

    isPinned Boolean @default(false)

    likes    PostLike[]
    comments PostComment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model PostLike {
    id     String @id @default(uuid())
    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([postId, userId])
}

model PostComment {
    id     String @id @default(uuid())
    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model CampusSignal {
    id        String   @id @default(uuid())
    title     String
    category  String? // e.g. "CRPC", "ACADEMIC", "ENDORSEMENT"
    timeText  String? // e.g. "15m ago"
    linkUrl   String?
    createdAt DateTime @default(now())
}

// ============================================================================
// 5. ALUMNI DIRECTORY
// ============================================================================

model AlumniDirectory {
    id            String   @id @default(uuid())
    fullName      String   @db.VarChar(120)
    avatarUrl     String?
    company       String   @db.VarChar(120) // e.g. "Microsoft", "Amazon"
    role          String   @db.VarChar(120) // e.g. "Software Development Engineer II"
    batch         String // e.g. "Class of 2024"
    passoutYear   Int // e.g. 2024 (Numeric filter)
    branch        String // e.g. "CSE", "IT", "ECE"
    domain        String   @db.VarChar(80) // "Distributed Systems", "Cloud & DevOps", "AI / ML"
    skills        String[] @default([]) // ["Next.js", "Azure", "C++"]
    linkedinUrl   String // Mandatory LinkedIn profile URL
    verifiedByTpo Boolean  @default(true)
    workEmail     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([company])
    @@index([domain])
    @@index([passoutYear])
    @@index([branch])
}

// ============================================================================
// 6. JOBS & PLACEMENT ENGINE (SUPERSET)
// ============================================================================

enum DriveType {
    FULL_TIME
    INTERNSHIP
}

enum ApplicationStage {
    APPLIED
    OA_SHORTLISTED
    TECHNICAL_INTERVIEW
    HR_ROUND
    OFFERED
    REJECTED
}

// On-Campus Placement Drives created by TPO
model JobDrive {
    id             String    @id @default(uuid())
    company        String    @db.VarChar(120) // e.g. "Microsoft"
    logoLetter     String    @default("CO") // e.g. "MS"
    role           String    @db.VarChar(120) // e.g. "Software Development Engineer (SDE 1)"
    type           DriveType @default(FULL_TIME)
    category       String    @default("SDE") // "SDE" | "INTERN" | "DATA" | "DEVOPS"
    ctc            String // e.g. "₹44.5 LPA"
    ctcLpa         Float // e.g. 44.5 (Sorting & dream upgrade check)
    isDreamCompany Boolean   @default(false)
    location       String    @default("Pan India")
    deadline       DateTime

    // Eligibility Criteria (TPO Rules)
    cgpaCutoff        Float    @default(6.0)
    allowedBranches   String[] @default(["CSE", "IT", "ECE"])
    maxBacklogs       Int      @default(0)
    minVerifiedBadges Int      @default(0)
    batch             String // e.g. "2026 Batch"
    requiredTrack     String?
    description       String   @db.Text
    isActive          Boolean  @default(true)

    applications JobApplication[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([company])
    @@index([batch])
    @@index([isActive])
}

// Curated Off-Campus Opportunities (External Apply Links)
model OffCampusJob {
    id             String    @id @default(uuid())
    company        String    @db.VarChar(120)
    logoLetter     String    @default("OC")
    role           String    @db.VarChar(120)
    type           DriveType @default(FULL_TIME)
    compensation   String // e.g. "₹12 - 18 LPA"
    location       String
    batchEligible  String // e.g. "2025, 2026"
    deadline       DateTime
    requiredSkills String[]  @default([])
    portalSource   String // e.g. "LinkedIn", "Wellfound"
    applyUrl       String // External link
    isHot          Boolean   @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([company])
}

// On-Campus Application Tracker (Only Links Student <-> On-Campus Drive)
model JobApplication {
    id String @id @default(uuid())

    driveId String
    drive   JobDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)

    studentId String
    student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    currentStage    ApplicationStage @default(APPLIED)
    isOfferAccepted Boolean          @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([driveId, studentId]) // 1 student 1 application per on-campus drive
    @@index([studentId])
    @@index([currentStage])
}

enum ProcessingStatus {
    PENDING
    PROCESSED
    FAILED
    REJECTED
}

// Staging Table for Scraper Agents (Raw Data Buffer)
model RawJobPosting {
    id         String           @id @default(uuid())
    source     String // e.g. "LinkedIn", "Wellfound", "Greenhouse", "leco.ai"
    rawPayload Json // Agent ka poora uncleaned JSON / text
    status     ProcessingStatus @default(PENDING)
    errorLog   String?

    publishedJobId String? // Clean publish hone ke baad OffCampusJob ki ID

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([source])
}
